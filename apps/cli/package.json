{
  "name": "superself",
  "version": "0.12.0",
  "description": "Version control for your project's state. Installs the `self` CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxylabs/superself.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/fxylabs/superself#readme",
  "bugs": "https://github.com/fxylabs/superself/issues",
  "keywords": [
    "agents",
    "project-state",
    "memory",
    "context",
    "claude",
    "ai",
    "cli",
    "workspace"
  ],
  "type": "module",
  "bin": {
    "self": "bin/self.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run release-keys && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test test/*.test.mjs",
    "structure": "node test/structure.mjs",
    "release-keys": "node test/release-keys.mjs"
  },
  "dependencies": {
    "@superself/fold": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.9.3"
  }
}
