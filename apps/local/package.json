{
  "name": "@fxylabs/superself-local",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "SUPERSELF_OPEN_BROWSER=false SUPERSELF_PRINT_PAIRING_URL=true SUPERSELF_WEB_URL=http://127.0.0.1:5173 node --import tsx src/server.ts",
    "dev:web": "vite",
    "proof": "node --import tsx src/proof.ts",
    "build:web": "vite build",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build": "pnpm build:web && pnpm build:server",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@hono/node-server": "1.19.14",
    "@sinclair/typebox": "0.34.52",
    "@spfn/core": "0.2.0-beta.64",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.27",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "20.19.33",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.1",
    "esbuild": "0.27.7",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
