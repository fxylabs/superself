{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": false,
        "skipLibCheck": true,
        "outDir": "dist",
        "types": ["node"]
    },
    "include": ["src", "tsup.config.ts"]
}
